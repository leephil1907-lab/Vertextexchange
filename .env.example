# Vertex Trader — environment configuration
# Copy to .env (or pass inline) when starting: node server/index.js

# --- Email delivery (optional but recommended) ---
# When unset, generated emails are honestly queued in each user's outbox
# (visible in Dashboard → Notifications and Admin → Outbox) and never sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Vertex Trader <no-reply@vertextrader.app>

# --- Public base URL used in email links (optional) ---
APP_URL=

# --- Admin bootstrap (created on first start if missing) ---
ADMIN_EMAIL=admin@vertextrader.app
ADMIN_PASSWORD=change-me-before-production
